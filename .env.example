# ------------------------------------------------------------
# 基本設定
# ------------------------------------------------------------
# development: 開発向けログ / production: JSONログ（本番・Compose推奨）
NODE_ENV=production
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Discord Developer Portalで発行したBot token。必須・Gitへcommitしないこと。
DISCORD_TOKEN=
# 管理コマンドを許可するDiscordユーザーID（17〜20桁のsnowflake）。必須。
OWNER_USER_ID=

# ------------------------------------------------------------
# 利用範囲
# ------------------------------------------------------------
# 許可するDiscord IDをカンマ区切りで指定。空欄は全許可。
# 両方を設定した場合は、guildとchannelの両条件を満たす必要がある。
ALLOWED_GUILD_IDS=
ALLOWED_CHANNEL_IDS=

# ------------------------------------------------------------
# pixiv取得・画像表示
# ------------------------------------------------------------
# i.pximg.netのURLを書き換える画像プロキシの基点。
# 認証情報・query・fragmentを含まないHTTP(S) URLだけを指定できる。
PXIMG_PROXY_BASE_URL=https://phixiv.net/i
# 取得経路の並び。死んだ経路をコード変更なしで外せる（ADR 0003）
# 使用可能値: ajax,phixiv,ogp。1つ以上必要。
SOURCE_CHAIN=ajax,phixiv,ogp
# phixiv のフォーク移転・自前ホストへの切り替え口（ADR 0014）
PHIXIV_BASE_URL=https://phixiv.net
# 1 URL あたりの取得総予算。超過したら次の経路を起動しない
FETCH_TOTAL_BUDGET_MS=8000
# components_v2（推奨）| embed（退避経路）
RENDERER=components_v2

# ------------------------------------------------------------
# Redis・ヘルスチェック
# ------------------------------------------------------------
# npm run dev では localhost。Compose はサービス内ホストへ上書きする。
# TLSを使う場合は rediss:// を指定できる。
REDIS_URL=redis://localhost:6379
# deny（推奨）: Redis不通時は全展開を停止 / allow: ban・block未確認でも展開
REDIS_DOWN_FALLBACK=deny

# /healthz /readyz /health /metrics の待受ポート（1〜65535）。
# 現在は0.0.0.0へbindするため、外部公開しないネットワーク構成で使う。
HEALTH_PORT=9090

# ------------------------------------------------------------
# 処理上限・上流保護
# ------------------------------------------------------------
# 1メッセージから展開するURL数。Discord/実装上限は3。
MAX_URLS_PER_MESSAGE=3
# 1作品の通常表示枚数と硬い上限。1〜10かつDEFAULT <= HARD。
MAX_PAGES_DEFAULT=4
MAX_PAGES_HARD=10
# 取得元1経路あたりのtimeout（ms）。ajax・phixivへ適用し、OGPは最大2500ms。
# URL全体の予算はFETCH_TOTAL_BUDGET_MS。
SOURCE_TIMEOUT_MS=3000
# pixivホストに対する毎秒リクエスト数。正の有限値。
PIXIV_RPS=1
# 60秒窓でこの回数失敗したらcircuitを開き、OPEN_MS後に半開する。
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_MS=120000
# 利用者・チャンネル単位のcooldown（ms）。超過時は無反応。
USER_COOLDOWN_MS=10000
CHANNEL_COOLDOWN_MS=5000

# ------------------------------------------------------------
# 年齢制限・表示ポリシー
# ------------------------------------------------------------
# 年齢制限チャンネルでも制限付き作品をspoiler表示する。
SPOILER_IN_NSFW=true
# trueにするとDMを年齢制限チャンネル相当として扱う。既定falseを推奨。
ALLOW_NSFW_IN_DM=false
# 全年齢だがセンシティブな作品を通常チャンネルでどう扱うか
# spoiler | link_only | skip
# 将来互換用。v1の取得結果はsensitive=false固定のため、通常は挙動に影響しない。
SENSITIVE_IN_SFW=spoiler
# 年齢区分を確定できなかった作品を通常チャンネルでどう扱うか（fail-closed）
# skip（推奨）| link_only
UNKNOWN_RATING_SFW=skip
# 表示に使う画像変種の選好順。original は選べない（ADR 0014）
# regular | small | thumb をカンマ区切りで1つ以上指定。
IMAGE_VARIANT_PREFERENCE=regular,small,thumb
